<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SubForgeAI Studio — Instalação" Width="1060" Height="730" MinWidth="880" MinHeight="650"
 WindowStartupLocation="CenterScreen" Background="#101216" Foreground="#EEEAE4" FontFamily="Segoe UI" FontSize="14" WindowStyle="None" ResizeMode="CanResizeWithGrip">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EEEAE4"/><Setter Property="Background" Value="#1D2129"/><Setter Property="BorderBrush" Value="#414956"/><Setter Property="Padding" Value="20,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEEAE4"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#EEEAE4"/><Setter Property="Background" Value="#111419"/><Setter Property="BorderBrush" Value="#343B48"/><Setter Property="Padding" Value="12,9"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#7B5DB4"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinWidth" Value="150"/><Setter Property="Foreground" Value="#EEEAE4"/><Setter Property="Background" Value="#1D2129"/><Setter Property="BorderBrush" Value="#414956"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"><Grid><ContentPresenter Margin="10,8,28,8" TextElement.Foreground="{TemplateBinding Foreground}" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"/><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#A78BFA"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#1D2129" BorderBrush="#414956" BorderThickness="1" CornerRadius="7" MinWidth="150" Padding="4"><StackPanel IsItemsHost="True"/></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#EEEAE4"/><Setter Property="Background" Value="#1D2129"/><Setter Property="Padding" Value="10,8"/></Style>
 </Window.Resources>
 <Border BorderBrush="#343B48" BorderThickness="1" CornerRadius="12">
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border x:Name="TitleBar" Background="#191C22" CornerRadius="12,12,0,0"><Grid Margin="18,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="[ ]" FontSize="22" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,0,12,0"/><TextBlock x:Name="WindowLabel" Text="SubForgeAI Studio — Instalação" VerticalAlignment="Center"/></StackPanel><Button x:Name="Minimize" Grid.Column="1" Content="—" Background="Transparent" BorderBrush="Transparent" Padding="8"/><Button x:Name="Close" Grid.Column="2" Content="✕" Background="Transparent" BorderBrush="Transparent" Padding="8"/></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#0C0E11" CornerRadius="0,0,0,12" BorderBrush="#262B34" BorderThickness="0,0,1,0"><Grid Margin="22,30,18,24"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><TextBlock Text="[ ]" Foreground="#A78BFA" FontSize="32" FontWeight="SemiBold" Margin="0,0,12,0"/><StackPanel Margin="0,4,0,0"><TextBlock Text="SubForgeAI" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Studio" FontSize="15" Foreground="#A0A7B3"/></StackPanel></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,12,0,0">
     <Border x:Name="Step0" CornerRadius="9" Padding="12,15" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Glyph0" Text="1" Foreground="#A78BFA" FontSize="20" Width="30"/><TextBlock x:Name="Label0" Text="Local de instalação" VerticalAlignment="Center"/></StackPanel></Border>
     <Border x:Name="Step1" CornerRadius="9" Padding="12,15" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Glyph1" Text="2" Foreground="#A0A7B3" FontSize="20" Width="30"/><TextBlock x:Name="Label1" Text="Baixar arquivos" VerticalAlignment="Center"/></StackPanel></Border>
     <Border x:Name="Step2" CornerRadius="9" Padding="12,15" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Glyph2" Text="3" Foreground="#A0A7B3" FontSize="20" Width="30"/><TextBlock x:Name="Label2" Text="Verificar" VerticalAlignment="Center"/></StackPanel></Border>
     <Border x:Name="Step3" CornerRadius="9" Padding="12,15"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Glyph3" Text="4" Foreground="#A0A7B3" FontSize="20" Width="30"/><TextBlock x:Name="Label3" Text="Concluir" VerticalAlignment="Center"/></StackPanel></Border>
<StackPanel x:Name="ConnectionRow" Margin="12,28,12,0"><TextBlock x:Name="ConnectionLabel" Text="Conexões" VerticalAlignment="Center" Foreground="#A0A7B3" Margin="0,0,0,8"/><ComboBox x:Name="Connections" SelectedIndex="0"><ComboBoxItem Content="4 · Automático"/><ComboBoxItem Content="1 · Compatibilidade"/></ComboBox></StackPanel>
    </StackPanel>
    <ComboBox x:Name="Language" Grid.Row="2" SelectedIndex="0"><ComboBoxItem Content="Português (Brasil)"/><ComboBoxItem Content="English"/><ComboBoxItem Content="Español"/></ComboBox>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="34,28,34,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border HorizontalAlignment="Left" Background="#1D2129" BorderBrush="#343B48" BorderThickness="1" CornerRadius="6" Padding="10,5"><TextBlock x:Name="Version" Foreground="#BBA5FF" FontSize="12" Text="VERSÃO 1.0.5"/></Border>
    <StackPanel Grid.Row="1" Margin="0,19,0,22"><TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold" Text="Instale o SubForgeAI" TextWrapping="Wrap"/><TextBlock x:Name="Subtitle" Foreground="#A0A7B3" FontSize="16" Margin="0,9,0,0" TextWrapping="Wrap" Text="Seu estúdio de legendas começa aqui."/></StackPanel>
    <Border Grid.Row="2" Background="#171A20" BorderBrush="#2B3039" BorderThickness="1" CornerRadius="12" Padding="22,20" Margin="0,0,0,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal"><Border Background="#292339" Width="48" Height="48" CornerRadius="10" Margin="0,0,16,0"><TextBlock x:Name="StageIcon" Text="↓" FontSize="32" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StageTitle" Text="Pronto para instalar" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="StageHint" Text="Download verificado e retomada automática" Foreground="#A0A7B3" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></StackPanel>
     <Grid Grid.Row="1" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><ProgressBar x:Name="Progress" Maximum="100" Height="12" Background="#2B3039" Foreground="#A78BFA" BorderThickness="0"/><TextBlock x:Name="Percent" Grid.Column="1" Text="0%" FontWeight="SemiBold" FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Amount" Text="Download: 5,8 GB" Foreground="#B6BECA"/><TextBlock x:Name="Speed" Grid.Column="1" Text="Aplicativo: 9,6 GB" Foreground="#B6BECA"/></Grid>
     <TextBlock x:Name="Detail" Grid.Row="3" Margin="0,16,0,0" Foreground="#A0A7B3" TextWrapping="Wrap" MaxHeight="62" Text="Sem instalar Python ou outros programas à parte."/>
    </Grid></Border>
    <Border Grid.Row="3" Background="#171A20" BorderBrush="#2B3039" BorderThickness="1" CornerRadius="12" Padding="18,15"><StackPanel><TextBlock x:Name="FolderLabel" Text="Pasta de instalação" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Destination" MinWidth="180"/><Button x:Name="Browse" Grid.Column="1" Content="Escolher" Margin="10,0,0,0" Padding="14,8"/></Grid></StackPanel></Border>
    <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="0,16,0,12"><TextBlock x:Name="ModelsHint" Foreground="#A0A7B3" TextWrapping="Wrap" Text="Os modelos de IA serão escolhidos no Studio."/></StackPanel>
    <Grid Grid.Row="5" Margin="0,8,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Details" Content="Ver detalhes" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="0,10" Foreground="#A0A7B3"/><Button x:Name="Secondary" Grid.Column="1" Content="Cancelar" MinWidth="110" Margin="8,0,12,0"/><Button x:Name="Primary" Grid.Column="2" Content="Instalar" Background="#A78BFA" Foreground="#191326" BorderBrush="#A78BFA" FontWeight="SemiBold" MinWidth="170"/></Grid>
    <Border Grid.Row="6" BorderBrush="#2B3039" BorderThickness="0,1,0,0" Padding="0,12,0,0"><TextBlock Text="SubForgeAI Studio" Foreground="#69717F" FontSize="12"/></Border>
   </Grid>
  </Grid>
 </Grid></Border>
</Window>

